{
  "name": "yusra-uat",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright UAT journeys for all six Yusra Pharmacy roles. Drives the real Flutter web build against a local Supabase stack.",
  "scripts": {
    "list": "playwright test --list",
    "test": "playwright test",
    "test:stack": "bash bootstrap/run-tests.sh",
    "test:desktop": "playwright test --project=chromium-desktop",
    "test:mobile": "playwright test --project=chromium-mobile",
    "report": "playwright show-report artifacts/playwright-report"
  },
  "devDependencies": {
    "@playwright/test": "1.48.2",
    "@types/node": "^22.10.2",
    "typescript": "^5.6.3"
  }
}
